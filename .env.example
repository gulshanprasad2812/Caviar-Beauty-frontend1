VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Firebase Phone Auth (free). From Firebase console -> Project settings ->
# General -> your web app config. All of these are public (they ship in the
# browser bundle); the API only needs FIREBASE_API_KEY + FIREBASE_PROJECT_ID to
# check the ID token. Leave blank to keep SMS verification disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional. The Paytm MID and one-time txnToken are served by the API at
# checkout time, so this is only needed for a build-time fallback. Never put
# the Paytm merchant key in the frontend.
VITE_PAYTM_MID=
# Optional script host override (defaults to staging; production is
# https://secure.paytmpayments.com).
VITE_PAYTM_HOST=
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Leave unset for local Vite proxy and the production same-origin Vercel proxy.
# Set only if intentionally using a direct development API URL.
VITE_API_URL=
